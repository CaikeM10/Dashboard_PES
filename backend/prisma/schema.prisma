generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COORDENADOR
  SECRETARIO
}

enum StatusMeta {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
  ATRASADO
}

model Usuario {
  id    String @id @default(uuid())
  nome  String
  email String @unique
  senha String
  role  Role

  metas Meta[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Desafio {
  id        String  @id @default(uuid())
  titulo    String
  descricao String?

  objetivos Objetivo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Objetivo {
  id        String  @id @default(uuid())
  titulo    String
  descricao String?
  indicador String?

  desafioId String
  desafio   Desafio @relation(fields: [desafioId], references: [id])

  metas    Meta[]
  entregas Entrega[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meta {
  id        String @id @default(uuid())
  descricao String

  status     StatusMeta
  percentual Int        @default(0)

  prazo DateTime?

  objetivoId String
  objetivo   Objetivo @relation(fields: [objetivoId], references: [id])

  responsavelId String?
  responsavel   Usuario? @relation(fields: [responsavelId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Entrega {
  id        String  @id @default(uuid())
  descricao String
  indicador String?

  objetivoId String
  objetivo   Objetivo @relation(fields: [objetivoId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Escola {
  id   String @id @default(uuid())
  nome String

  prioritario Boolean @default(false)

  endereco String?
  bairro   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Relatorio {
  id      String @id @default(uuid())
  titulo  String
  arquivo String

  createdAt DateTime @default(now())
}
model IdentidadeOrganizacional {
  id        String   @id @default(uuid())
  missao    String?
  visao     String?
  valores   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}